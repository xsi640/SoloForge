<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.soloforge.board.column.mapper.BoardColumnMapper">

    <resultMap id="boardColumnResultMap" type="com.soloforge.board.column.entity.BoardColumn">
        <id property="id" column="id"/>
        <result property="boardId" column="board_id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="sortOrder" column="sort_order"/>
    </resultMap>

    <sql id="boardColumnColumns">
        id, board_id, code, name, sort_order
    </sql>

    <select id="findByBoardId" resultMap="boardColumnResultMap">
        SELECT
        <include refid="boardColumnColumns"/>
        FROM board_column
        WHERE board_id = #{boardId}
        ORDER BY sort_order ASC
    </select>

    <select id="findById" resultMap="boardColumnResultMap">
        SELECT
        <include refid="boardColumnColumns"/>
        FROM board_column
        WHERE id = #{id}
    </select>

</mapper>
