<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.soloforge.board.board.mapper.BoardMapper">

    <resultMap id="boardResultMap" type="com.soloforge.board.board.entity.Board">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="boardColumns">
        id, name, created_at, updated_at
    </sql>

    <select id="findById" resultMap="boardResultMap">
        SELECT
        <include refid="boardColumns"/>
        FROM board
        WHERE id = #{id}
    </select>

    <select id="findFirst" resultMap="boardResultMap">
        SELECT
        <include refid="boardColumns"/>
        FROM board
        ORDER BY id ASC
        LIMIT 1
    </select>

</mapper>
