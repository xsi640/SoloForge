<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.soloforge.board.auth.mapper.AppUserMapper">

    <resultMap id="AppUserResultMap" type="com.soloforge.board.auth.entity.AppUser">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="display_name" property="displayName"/>
        <result column="password_hash" property="passwordHash"/>
        <result column="is_admin" property="admin"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="AppUserColumns">
        id, username, display_name, password_hash, is_admin, status, created_at, updated_at
    </sql>

    <select id="findById" resultMap="AppUserResultMap">
        SELECT <include refid="AppUserColumns"/>
        FROM app_user
        WHERE id = #{id}
    </select>

    <select id="findByUsername" resultMap="AppUserResultMap">
        SELECT <include refid="AppUserColumns"/>
        FROM app_user
        WHERE username = #{username}
    </select>

    <select id="findAll" resultMap="AppUserResultMap">
        SELECT <include refid="AppUserColumns"/>
        FROM app_user
        ORDER BY created_at ASC, id ASC
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*)
        FROM app_user
    </select>

    <insert id="insert" parameterType="com.soloforge.board.auth.entity.AppUser" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO app_user (username, display_name, password_hash, is_admin, status, created_at, updated_at)
        VALUES (#{username}, #{displayName}, #{passwordHash}, #{admin}, #{status}, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
    </insert>

    <update id="updatePasswordHash">
        UPDATE app_user
        SET password_hash = #{passwordHash}, updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <update id="updateStatus">
        UPDATE app_user
        SET status = #{status}, updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>
</mapper>
